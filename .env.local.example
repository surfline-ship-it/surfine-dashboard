# HubSpot Private App Token (create at Settings > Integrations > Private Apps)
# Scopes needed: crm.objects.contacts.read, crm.objects.deals.read, crm.objects.companies.read
HUBSPOT_ACCESS_TOKEN=pat-na2-xxxxxxxx

# JWT secret for session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=your-random-secret-here

# Google Sheets API key (Sheets API enabled; sheet must be readable by the key / public)
GOOGLE_API_KEY=your-google-api-key

# Partner credentials (JSON map of access code -> { partner, label, search? })
# `partner` is the HubSpot pepartner value. Use partner "ALL" + label for Surfline admin;
# admin login receives `adminPartnerOptions` (distinct partners from this file, excluding ALL).
# Add the admin entry alongside existing partner codes, for example:
# "sc-surfline-admin-7x9k": { "partner": "ALL", "label": "Surfline Capital — Admin" }
PARTNER_CREDENTIALS={"trivest2026":{"partner":"Trivest","label":"Trivest Partners"},"incline2026":{"partner":"Incline","label":"Incline Equity Partners"}}

# DNC Google Sheet IDs per partner key (JSON). Partners without an entry show "No DNC list configured" in Leads.
DNC_SHEET_CONFIG={"Trivest":"1889Fsfs8xu-uDQgCX46YMLKlFX-J5WlLAGLUTwPIGso"}
